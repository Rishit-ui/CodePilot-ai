# =====================================================================
# CodePilot AI — Environment Configuration Template
# Copy this file to .env to customize settings. Never commit real secrets.
# =====================================================================

# Server Configuration
NODE_ENV=development
CODEPILOT_HOST=127.0.0.1
CODEPILOT_PORT=3000
CODEPILOT_DATA_DIR=.data

# Session & Authentication
# In production (NODE_ENV=production), CODEPILOT_SESSION_SECRET is strictly required
CODEPILOT_SESSION_SECRET=dev-insecure-secret-key-32-chars-min-length-1234
CODEPILOT_AUTH_ENABLED=false

# AI Model Provider
# Options: 'local' (deterministic evidence citations) | 'openai' | 'anthropic' | 'gemini'
CODEPILOT_AI_PROVIDER=local
CODEPILOT_AI_API_KEY=
CODEPILOT_AI_MODEL=gpt-4o-mini
CODEPILOT_AI_BASE_URL=

# Cloud Deployment Adapters (Optional Credentials)
RENDER_API_KEY=
VERCEL_TOKEN=
FLY_API_TOKEN=

# Ingestion & Execution Limits
CODEPILOT_MAX_UPLOAD_BYTES=10485760
CODEPILOT_MAX_EXTRACTED_BYTES=31457280
CODEPILOT_MAX_FILES=1500
CODEPILOT_MAX_FILE_BYTES=2097152
CODEPILOT_MAX_COMPRESSION_RATIO=100
CODEPILOT_CMD_TIMEOUT_MS=30000

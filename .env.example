# =====================================================================
# CodePilot AI — Environment Configuration Template
# Copy this file to .env to customize settings. Never commit real secrets.
# =====================================================================

# Server Configuration
NODE_ENV=development
CODEPILOT_HOST=127.0.0.1
CODEPILOT_PORT=3000
CODEPILOT_DATA_DIR=.data

# Session & Authentication
# Production requires a unique random value of at least 32 characters.
# Example generation: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
CODEPILOT_SESSION_SECRET=
CODEPILOT_AUTH_ENABLED=true

# Optional PostgreSQL adapter. Leave empty to use the persistent SQLite data directory.
DATABASE_URL=
CODEPILOT_DB_SSL_MODE=prefer
CODEPILOT_DB_POOL_MAX=10
CODEPILOT_DB_CONNECTION_TIMEOUT_MS=5000
CODEPILOT_DB_QUERY_TIMEOUT_MS=15000

# Distributed rate limiting (production requires PostgreSQL when enabled)
CODEPILOT_RATE_LIMIT_ENABLED=true
CODEPILOT_TRUST_PROXY=false
CODEPILOT_TRUSTED_PROXY_HOPS=0
CODEPILOT_AUTH_FAILURE_MAX=5
CODEPILOT_AUTH_FAILURE_WINDOW_MS=900000
# Per-policy overrides follow CODEPILOT_RATE_<POLICY>_SUBJECT_MAX,
# CODEPILOT_RATE_<POLICY>_IP_MAX and CODEPILOT_RATE_<POLICY>_WINDOW_MS.
# Policies: REGISTRATION, LOGIN, AI, IMPORT, ANALYSIS, PATCH, EXECUTION, DEPLOYMENT.

# Production must use disabled or a separately authenticated external worker.
CODEPILOT_EXECUTION_MODE=local-development
CODEPILOT_WORKER_URL=
CODEPILOT_WORKER_TOKEN=
CODEPILOT_WORKER_PROVIDER=disabled
CODEPILOT_WORKER_TIMEOUT_MS=120000
CODEPILOT_WORKER_COMMAND_TIMEOUT_MS=60000
CODEPILOT_WORKER_OUTPUT_BYTES=1048576
CODEPILOT_WORKER_VCPUS=1

# Durable providers. Leave disabled until separate staging resources are authorized.
CODEPILOT_QUEUE_PROVIDER=disabled
CODEPILOT_QUEUE_TOPIC=codepilot-jobs
CODEPILOT_QUEUE_REGION=iad1
CODEPILOT_STORAGE_PROVIDER=disabled
CODEPILOT_STORAGE_MAX_OBJECT_BYTES=262144000
CODEPILOT_UPLOAD_TTL_MS=600000
CODEPILOT_ARTIFACT_RETENTION_DAYS=7

# Per-user cost and abuse ceilings.
CODEPILOT_JOBS_PER_USER_HOUR=10
CODEPILOT_CONCURRENT_JOBS_PER_USER=2
CODEPILOT_STORAGE_BYTES_PER_USER=524288000

# AI Model Provider
# Options: 'local' (deterministic evidence citations) | 'openai' | 'anthropic' | 'gemini'
CODEPILOT_AI_PROVIDER=local
CODEPILOT_AI_API_KEY=
CODEPILOT_AI_MODEL=gpt-4o-mini
CODEPILOT_AI_BASE_URL=

# Cloud Deployment Adapters (Optional Credentials)
RENDER_API_KEY=
VERCEL_TOKEN=
FLY_API_TOKEN=

# Ingestion & Execution Limits
CODEPILOT_MAX_UPLOAD_BYTES=10485760
CODEPILOT_MAX_EXTRACTED_BYTES=31457280
CODEPILOT_MAX_FILES=1500
CODEPILOT_MAX_FILE_BYTES=2097152
CODEPILOT_MAX_COMPRESSION_RATIO=100
CODEPILOT_CMD_TIMEOUT_MS=30000

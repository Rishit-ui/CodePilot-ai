# Copy this file to .env.docker and fill both blank secrets before starting.
# Never commit .env.docker. Generate values with a cryptographically secure tool.
CODEPILOT_SESSION_SECRET=
POSTGRES_PASSWORD=

# Non-secret local Docker settings.
POSTGRES_DB=codepilot
POSTGRES_USER=codepilot
CODEPILOT_BIND_ADDRESS=127.0.0.1
CODEPILOT_PORT=3000

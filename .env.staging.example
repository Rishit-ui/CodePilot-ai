# Staging-only placeholders. Never copy production secrets into this file.
NODE_ENV=production
CODEPILOT_AUTH_ENABLED=true
CODEPILOT_SESSION_SECRET=
DATABASE_URL=
CODEPILOT_DB_SSL_MODE=verify-full
CODEPILOT_RATE_LIMIT_ENABLED=true
CODEPILOT_TRUST_PROXY=true
CODEPILOT_TRUSTED_PROXY_HOPS=1

# The platform may use queue and private storage in staging. Execution stays off.
CODEPILOT_EXECUTION_MODE=disabled
CODEPILOT_WORKER_PROVIDER=disabled
CODEPILOT_QUEUE_PROVIDER=vercel-queues
CODEPILOT_QUEUE_TOPIC=codepilot-staging-jobs
CODEPILOT_QUEUE_REGION=iad1
CODEPILOT_STORAGE_PROVIDER=vercel-blob
# Vercel injects OIDC into linked deployments. Do not paste a production token.
VERCEL_OIDC_TOKEN=
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Choose local for a zero-cost staging baseline, or set all external fields.
CODEPILOT_AI_PROVIDER=local
CODEPILOT_AI_API_KEY=
CODEPILOT_AI_MODEL=
CODEPILOT_AI_TIMEOUT_MS=25000
CODEPILOT_AI_MAX_RETRIES=2
CODEPILOT_AI_MAX_RESPONSE_BYTES=1048576

# Provider test gates remain unset unless a specifically authorized run is planned.
TEST_VERCEL_QUEUE=
TEST_VERCEL_BLOB=
TEST_VERCEL_SANDBOX=
TEST_SANDBOX_DESTRUCTIVE=
TEST_ADVERSARIAL_DB_HOST=
TEST_ADVERSARIAL_DB_PORT=5432
TEST_EXTERNAL_AI=
TEST_POSTGRES_URL=
TEST_POSTGRES_SSL_MODE=verify-full
